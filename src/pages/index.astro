---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Renato Ricco">
	<main class="container">
		<section class="hero">
			<div class="hero-content">
				<h1 class="title">
					<span class="greeting">Olá, eu sou</span>
					Renato Ricco
				</h1>
				
				<p class="subtitle">
					Arquiteto de software, entusiasta de tecnologia e música.
					Trabalhando com desenvolvimento web e arquitetura de sistemas.
				</p>

				<div class="social-links">
					<a
						href="https://www.linkedin.com/in/renatoricco/"
						target="_blank"
						rel="noopener noreferrer"
						title="LinkedIn"
						class="social-icon"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
							></path><rect x="2" y="9" width="4" height="12"
							></rect><circle cx="4" cy="4" r="2"></circle></svg
						>
					</a>

					<a
						href="https://instagram.com/ricco.pics"
						target="_blank"
						rel="noopener noreferrer"
						title="Instagram"
						class="social-icon"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="2"
								width="20"
								height="20"
								rx="5"
								ry="5"></rect><path
								d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
							></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
							></line></svg
						>
					</a>

					<a
						href="https://www.last.fm/user/renatoakamur"
						target="_blank"
						rel="noopener noreferrer"
						title="Last.fm"
						class="social-icon"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 15a5 5 0 1 1 5-5A5 5 0 0 1 12 17zm3-5a3 3 0 1 1-3-3A3 3 0 0 1 15 12z"
							></path></svg
						>
					</a>
				</div>
			</div>
			
			<div class="hero-image">
				<div class="avatar-circle">
					<div class="avatar-initials">RR</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 4rem 2rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.hero {
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 4rem;
		animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@media (min-width: 768px) {
		.hero {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;
			gap: 2rem;
		}
	}

	.hero-content {
		flex: 1;
		max-width: 600px;
		text-align: center;
	}

	@media (min-width: 768px) {
		.hero-content {
			text-align: left;
			padding-top: 2rem;
		}
	}

	.title {
		font-size: 3rem;
		font-weight: 800;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--text-main);
	}

	@media (min-width: 768px) {
		.title {
			font-size: 4rem;
		}
	}

	.greeting {
		display: block;
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--accent-color);
		margin-bottom: 0.5rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	@media (min-width: 768px) {
		.greeting {
			font-size: 1.5rem;
		}
	}

	.subtitle {
		font-size: 1.25rem;
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2.5rem;
		max-width: 500px;
	}

	@media (max-width: 767px) {
		.subtitle {
			margin-left: auto;
			margin-right: auto;
		}
	}

	.social-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		justify-content: center;
	}

	@media (min-width: 768px) {
		.social-links {
			justify-content: flex-start;
		}
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-main);
		border: 1px solid var(--card-border);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.social-icon:hover {
		transform: translateY(-4px);
		background: rgba(255, 255, 255, 0.1);
		color: var(--accent-hover);
		border-color: var(--accent-hover);
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2), 0 4px 6px -2px rgba(0, 0, 0, 0.1);
	}

	.social-icon svg {
		transition: transform 0.3s ease;
	}

	.social-icon:hover svg {
		transform: scale(1.1);
	}

	.hero-image {
		flex-shrink: 0;
	}

	.avatar-circle {
		position: relative;
		width: 200px;
		height: 200px;
		border-radius: 50%;
		padding: 8px;
		background: linear-gradient(135deg, var(--accent-color), #8b5cf6);
		box-shadow: 0 20px 40px -10px rgba(59, 130, 246, 0.4);
	}

	@media (min-width: 768px) {
		.avatar-circle {
			width: 280px;
			height: 280px;
		}
	}

	.avatar-initials {
		width: 100%;
		height: 100%;
		background-color: var(--bg-color);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 4rem;
		font-weight: 800;
		color: var(--text-main);
		border: 4px solid transparent;
		background-clip: padding-box;
	}

	@media (min-width: 768px) {
		.avatar-initials {
			font-size: 5rem;
		}
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
